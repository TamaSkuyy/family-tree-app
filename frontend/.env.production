# Production build settings (loaded automatically by `vite build`).
#
# Use a same-origin, relative path so the browser calls the domain it was served
# from. The nginx container inside the frontend image and the Caddy reverse proxy
# both forward /api/* to the backend, so no CORS entry is needed for this host.
#
# Do NOT set an absolute http://localhost:8080 URL here: that would make every
# visitor's browser call their own machine instead of the server.
VITE_API_BASE_URL=/api/v1
