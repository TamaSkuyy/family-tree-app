# Example environment variables for development
# Copy this file to .env (or set env vars in your shell)
#
# NOTE: `install-vps.sh` generates a real .env (with a random 96-char JWT_SECRET)
# on the server. Use this file only as a reference / for local runs.

# Set to 'production' in prod environments to enable fail-fast secret check
ENV=development

# JWT secret used to sign tokens. Replace before deploying to production.
JWT_SECRET=replace-this-with-a-strong-secret

# ── Production only (read by docker-compose.prod.yml) ─────────────────────────

# Domain(s) served with automatic HTTPS, comma-separated (e.g. example.com,www.example.com)
# DOMAIN=family.example.com

# Contact address for Let's Encrypt certificate notices
# ACME_EMAIL=you@example.com

# true = anonymous visitors may read the tree; write actions still require login
# PUBLIC_MODE=false
